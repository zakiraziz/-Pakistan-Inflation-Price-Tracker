# ---------------------------------------------------------------------------
# Configuration via environment — copy to .env (never commit .env).
# All values have safe defaults; nothing here is a secret by default.
# ---------------------------------------------------------------------------

# Web server
PORT=5010

# Cache backend: SimpleCache (default, in-process) | RedisCache
# For RedisCache also set REDIS_URL, e.g. redis://localhost:6379/0
CACHE_TYPE=SimpleCache
CACHE_TTL=300
# REDIS_URL=redis://localhost:6379/0

# Rate limiting (flask-limiter)
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_WRITE=60 per minute
# RATE_LIMIT_STORAGE=memory://

# Logging
LOG_LEVEL=INFO
JSON_LINES=1

# Scheduled ingestion (scheduler.py cron, UTC)
INGEST_CRON_DOW=sat
INGEST_CRON_HOUR=6

# Future: Postgres backend (schema is Postgres-compatible).
# Until the SQLAlchemy/Alembic migration lands, SQLite remains the store.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inflation

# Public deployment (reverse proxy terminates TLS)
# PUBLIC_BASE_URL=https://your-domain.example