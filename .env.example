# ---------------------------------------------------------------------------
# Configuration via environment — copy to .env (never commit .env).
# All values have safe defaults; nothing here is a secret by default.
# ---------------------------------------------------------------------------

# Web server
PORT=5010

# Cache backend: SimpleCache (default, in-process) | RedisCache
# For RedisCache also set REDIS_URL, e.g. redis://localhost:6379/0
CACHE_TYPE=SimpleCache
CACHE_TTL=300
# REDIS_URL=redis://localhost:6379/0

# Rate limiting (flask-limiter)
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_WRITE=60 per minute
# RATE_LIMIT_STORAGE=memory://

# Logging
LOG_LEVEL=INFO
JSON_LINES=1

# Admin / write protection (see core/auth.py)
# Admin routes (/api/admin/*, POST /ingest/next) can change the dataset.
#   ADMIN_TOKEN set   -> required on every protected request, sent as
#                        'X-Admin-Token: <token>' or 'Authorization: Bearer <token>'
#   ADMIN_TOKEN unset -> only strict-loopback callers (127.0.0.1 / ::1) may write;
#                        everyone else gets 403. Set a strong random value in
#                        production to allow authenticated writes.
# ADMIN_TOKEN=change-me-to-a-long-random-secret
# ADMIN_ALLOW_LOCAL=0   # fail closed even on localhost (e.g. nginx on the same host)

# Scheduled ingestion (scheduler.py cron, UTC)
INGEST_CRON_DOW=sat
INGEST_CRON_HOUR=6

# Future: Postgres backend (schema is Postgres-compatible).
# Until the SQLAlchemy/Alembic migration lands, SQLite remains the store.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inflation

# Public deployment (reverse proxy terminates TLS)
# PUBLIC_BASE_URL=https://your-domain.example